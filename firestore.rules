rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(participants) {
      return signedIn() && request.auth.uid in participants;
    }

    match /users/{uid} {
      // User profiles are searchable by authenticated users.
      allow read: if signedIn();

      // A user may create/update only their own profile.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid;

      allow delete: if false;
    }


    match /statuses/{statusId} {
      // Authenticated users may see only live statuses.
      allow read: if signedIn()
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;

      // A user may publish only as themselves, for at most 24 hours.
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, "h");

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;

      match /viewers/{viewerId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.authorId == request.auth.uid;

        allow create: if signedIn()
          && request.auth.uid == viewerId
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time;

        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow read: if signedIn()
        && (resource.data.caller == request.auth.uid
          || resource.data.callee == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid;

      allow update: if signedIn()
        && (resource.data.caller == request.auth.uid
          || resource.data.callee == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee;

      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Collection-group read rule for MissApp's global incoming-message listener.
    // app.js queries every messages subcollection with receiver == request.auth.uid.
    match /{path=**}/messages/{messageId} {
      allow read: if signedIn()
        && resource.data.receiver == request.auth.uid;
    }

    match /conversations/{conversationId} {
      // Allow checking whether a new conversation ID already exists.
      // If the document does not exist, there are no participant data to protect.
      allow read: if !exists(/databases/$(database)/documents/conversations/$(conversationId))
        || isParticipant(resource.data.participants);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && (
            resource.data.receiver == request.auth.uid
            || isParticipant(
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            )
          );

        allow create: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        )
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );

        allow write: if signedIn()
          && request.auth.uid == uid
          && isParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
      }
    }
  }
}
