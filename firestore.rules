rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(key) {
      return get(
        /databases/$(database)/documents/users/$(key)
      );
    }

    function isOwnUser(key) {
      return signedIn()
        && userDoc(key).data.uid == request.auth.uid;
    }

    function conversationParticipant() {
      return signedIn()
        && resource.data.participantUids.hasAny([
          request.auth.uid
        ]);
    }

    function newConversationParticipant() {
      return signedIn()
        && request.resource.data.participantUids.hasAny([
          request.auth.uid
        ]);
    }


    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────

    match /users/{key} {

      allow read: if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key == key;

      allow update:
        if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.key == key
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'online',
            'lastSeen',
            'language',
            'token',
            'notificationMode',
            'tokenUpdatedAt'
          ]);

      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // CONVERSATIONS
    // ─────────────────────────────────────────────

    match /conversations/{conversationId} {

      allow read:
        if conversationParticipant();

      allow create:
        if newConversationParticipant()
        && request.resource.data.participantUids is list
        && request.resource.data.participantKeys is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantKeys.size() == 2
        && request.resource.data.participantUids.hasAny([
          request.auth.uid
        ]);

      allow update:
        if conversationParticipant()
        && request.resource.data.participantUids
             == resource.data.participantUids
        && request.resource.data.participantKeys
             == resource.data.participantKeys;

      allow delete: if false;


      // ───────────────────────────────────────────
      // MESSAGES
      // ───────────────────────────────────────────

      match /messages/{messageId} {

        allow read:
          if signedIn()
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantUids.hasAny([
            request.auth.uid
          ]);


        allow create:
          if signedIn()

          // Sender must belong to the authenticated account.
          && userDoc(
               request.resource.data.sender
             ).data.uid == request.auth.uid

          // Sender must belong to this conversation.
          && get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantKeys.hasAny([
               request.resource.data.sender
             ])

          // Receiver must belong to this conversation.
          && get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantKeys.hasAny([
               request.resource.data.receiver
             ])

          // Cannot send a message to yourself.
          && request.resource.data.sender
               != request.resource.data.receiver

          // Names must match the UID-bound user records.
          && request.resource.data.senderName
               == userDoc(
                    request.resource.data.sender
                  ).data.username

          && request.resource.data.receiverName
               == userDoc(
                    request.resource.data.receiver
                  ).data.username

          // New messages start unread.
          && request.resource.data.read == false

          // Message text validation.
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;


        allow update:
          if signedIn()
          && userDoc(
               resource.data.receiver
             ).data.uid == request.auth.uid
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'read',
                 'readAt'
               ]);


        allow delete:
          if signedIn()
          && userDoc(
               resource.data.sender
             ).data.uid == request.auth.uid;
      }


      // ───────────────────────────────────────────
      // TYPING
      // ───────────────────────────────────────────

      match /typing/{key} {

        allow read:
          if signedIn()
          && get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantUids.hasAny([
            request.auth.uid
          ]);

        allow create, update, delete:
          if isOwnUser(key);
      }
    }
  }
}
