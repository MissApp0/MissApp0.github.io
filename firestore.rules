rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isParticipant(participantsList) {
      return isAuthenticated() && request.auth.uid in participantsList;
    }

    // Conversations collection rules
    match /conversations/{conversationId} {
      
      // Allow reading individual documents or querying (list) 
      // if the user's UID is inside the participants array.
      allow read: if isParticipant(resource.data.participants);

      // Allow creating a new conversation
      allow create: if isAuthenticated() 
        // Ensure the incoming participants list is a list and contains the creator's UID
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        // For a strict 1-to-1 chat, you can also enforce that length is 2:
        && request.resource.data.participants.size() == 2;

      // Allow updating (e.g., changing lastMessageAt) if the user is already a participant 
      // and remains a participant in the updated document
      allow update: if isParticipant(resource.data.participants) 
        && isParticipant(request.resource.data.participants);

      // Optional: restrict deletion if needed
      allow delete: if false; 
    }
  }
}
