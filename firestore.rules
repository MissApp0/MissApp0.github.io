rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The visible username is permanently bound to a Firebase Auth UID.
    // Every authorization decision below is made from that Auth UID, never a client claim.
    match /users/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.key == key;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.key == key && request.resource.data.username == resource.data.username && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastSeen', 'language', 'token', 'notificationMode', 'tokenUpdatedAt']);
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.participantUids.hasAny([request.auth.uid]);
      allow create: if signedIn() && request.resource.data.participantUids.hasAny([request.auth.uid]) && request.resource.data.participantUids.size() == 2 && request.resource.data.participantKeys.size() == 2;
      allow update: if signedIn() && resource.data.participantUids.hasAny([request.auth.uid]) && request.resource.data.participantUids == resource.data.participantUids && request.resource.data.participantKeys == resource.data.participantKeys;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids.hasAny([request.auth.uid]);
        allow create: if signedIn() && get(/databases/$(database)/documents/users/$(request.resource.data.sender)).data.uid == request.auth.uid && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantKeys.hasAny([request.resource.data.sender]) && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantKeys.hasAny([request.resource.data.receiver]) && request.resource.data.sender != request.resource.data.receiver && request.resource.data.senderName == get(/databases/$(database)/documents/users/$(request.resource.data.sender)).data.username && request.resource.data.receiverName == get(/databases/$(database)/documents/users/$(request.resource.data.receiver)).data.username && request.resource.data.read == false && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update: if signedIn() && get(/databases/$(database)/documents/users/$(resource.data.receiver)).data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if signedIn() && get(/databases/$(database)/documents/users/$(resource.data.sender)).data.uid == request.auth.uid;
      }
      match /typing/{key} {
        allow read: if signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids.hasAny([request.auth.uid]);
        allow create, update, delete: if signedIn() && get(/databases/$(database)/documents/users/$(key)).data.uid == request.auth.uid;
      }
    }
  }
}
