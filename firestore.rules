rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(participants) {
      return signedIn() && request.auth.uid in participants;
    }

    match /users/{uid} {
      // User profiles are searchable by authenticated users.
      allow read: if signedIn();

      // A user may create/update only their own profile.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid;

      allow delete: if false;
    }

    match /calls/{callId} {
      allow read: if signedIn()
        && (resource.data.caller == request.auth.uid
          || resource.data.callee == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid;

      allow update: if signedIn()
        && (resource.data.caller == request.auth.uid
          || resource.data.callee == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee;

      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid;
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(resource.data.participants);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );

        allow create: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        )
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );

        allow write: if signedIn()
          && request.auth.uid == uid
          && isParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          );
      }
    }
  }
}
