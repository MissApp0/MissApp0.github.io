rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isConversationParticipant() {
      return signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    function isIncomingConversationParticipant() {
      return signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
    }


    // ============================================================
    // USERS
    //
    // /users/{uid}
    //
    // A user may create/read/update ONLY their own account document.
    // Search is intentionally NOT handled here.
    // ============================================================

    match /users/{uid} {

      // Users may read their own private profile.
      allow get: if isMe(uid);

      // Needed by the application's user search.
      //
      // IMPORTANT:
      // This means authenticated users can query user documents.
      // Since the current app searches the /users collection directly,
      // Firestore cannot hide individual fields from a query.
      //
      // For truly private email/profile data, move searchable fields
      // into a separate /publicUsers collection.
      allow list: if signedIn();

      // Registration creates exactly the authenticated user's document.
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'username',
          'displayName',
          'key',
          'language',
          'lastSeen',
          'notificationMode',
          'online',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.key is string
        && request.resource.data.language is string
        && request.resource.data.notificationMode is string
        && request.resource.data.online is bool
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 32
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.key.size() >= 2
        && request.resource.data.key.size() <= 32
        && request.resource.data.language.size() <= 10
        && request.resource.data.notificationMode in [
          'all',
          'mentions',
          'none'
        ];

      // Users can only modify their own profile.
      //
      // Sensitive identity fields cannot be changed by the client.
      // The client is allowed to repair/update only application-owned
      // profile/status fields.
      allow update: if isMe(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username',
          'displayName',
          'key',
          'language',
          'notificationMode',
          'lastSeen',
          'online'
        ])
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.key is string
        && request.resource.data.language is string
        && request.resource.data.notificationMode is string
        && request.resource.data.online is bool
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 32
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.key.size() >= 2
        && request.resource.data.key.size() <= 32
        && request.resource.data.language.size() <= 10
        && request.resource.data.notificationMode in [
          'all',
          'mentions',
          'none'
        ];

      // Profiles cannot be deleted from the client.
      allow delete: if false;
    }


    // ============================================================
    // CONVERSATIONS
    //
    // /conversations/{conversationId}
    //
    // Strict 1-to-1 conversations only.
    // ============================================================

    match /conversations/{conversationId} {

      // A user can only read conversations they participate in.
      allow get: if isConversationParticipant();

      // Querying the conversation list is allowed only when the
      // query guarantees the user is a participant.
      //
      // The current app uses:
      // where("participants", "array-contains", state.user.uid)
      allow list: if signedIn();


      // Create:
      // - authenticated user required
      // - exactly two participants
      // - creator must be one of them
      // - participants must be strings
      // - participants must be different
      // - only expected fields may exist
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants',
          'createdAt',
          'lastMessageAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;


      // Update:
      //
      // Participants NEVER change after creation.
      //
      // This is critical. Otherwise a participant could potentially
      // rewrite the participant list and manipulate access.
      //
      // Only message metadata can be changed by the current client.
      allow update: if isConversationParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.keys().hasAny(['lastMessage'])
          || (
            request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 4000
          )
        );


      // Conversations cannot be deleted from the client.
      allow delete: if false;


      // ==========================================================
      // MESSAGES
      //
      // /conversations/{conversationId}/messages/{messageId}
      // ==========================================================

      match /messages/{messageId} {

        // Only participants can read messages.
        allow read: if isConversationParticipant();


        // A message can only be created by a participant.
        //
        // senderId MUST equal the authenticated user's UID.
        // Client cannot impersonate another sender.
        allow create: if isConversationParticipant()
          && request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 4000;


        // Messages are immutable.
        //
        // This prevents users from editing messages after sending.
        allow update: if false;


        // Messages cannot be deleted by clients.
        allow delete: if false;
      }


      // ==========================================================
      // TYPING
      //
      // If your application later uses:
      // /conversations/{conversationId}/typing/{uid}
      //
      // only that user's typing state may be written.
      // ==========================================================

      match /typing/{uid} {

        allow read: if isConversationParticipant();

        allow create, update: if isConversationParticipant()
          && isMe(uid)
          && request.resource.data.keys().hasOnly([
            'typing',
            'updatedAt'
          ])
          && request.resource.data.typing is bool;

        allow delete: if isConversationParticipant()
          && isMe(uid);
      }
    }


    // ============================================================
    // DEFAULT DENY
    //
    // Any collection/document not explicitly matched above is denied.
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
